# PostgreSQL
POSTGRES_DB=intelligent_supply_chain
POSTGRES_USER=isc
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
PORT=3001
DATABASE_URL=postgresql://isc:change-me@postgres:5432/intelligent_supply_chain
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
ML_SERVICE_URL=http://ml-service:8000
CORS_ORIGIN=http://localhost:5173

# Database SSL (explicit; never inferred from NODE_ENV)
# local Docker PostgreSQL: DB_SSL=false
# hosted PostgreSQL (e.g. Neon): DB_SSL=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ML service
ML_DATA_DIR=/app/public_supply_chain_synthetic/data
ML_ARTIFACT_DIR=/app/ml_service/artifacts

# Optional external API keys
GEMINI_API_KEY=
