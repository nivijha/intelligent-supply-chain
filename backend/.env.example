PORT=3001
DATABASE_URL=postgresql://isc:isc_password@localhost:5433/intelligent_supply_chain
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
ML_SERVICE_URL=http://localhost:8000
