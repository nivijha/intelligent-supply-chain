# Database SSL (explicit; never inferred from NODE_ENV)
# local PostgreSQL: DB_SSL=false
# hosted PostgreSQL (e.g. Neon): DB_SSL=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
